# /etc/song-tracker/env
# Copy this file to /etc/song-tracker/env and fill in your values.

# ── Audio ────────────────────────────────────────────────────────────
# Run `arecord -l` to list capture devices.
# USB audio adapter typically shows as hw:1,0
AUDIO_DEVICE=plughw:1,0

# Seconds of audio to capture per identification attempt
SAMPLE_DURATION=10

# Detection mode: "continuous" (trigger on audio) or "interval" (fixed poll)
MONITOR_MODE=continuous

# Seconds to wait between capture attempts (interval mode only)
POLL_INTERVAL=45

# RMS level below which audio is considered silent (0–32767 for 16-bit).
# Increase if capturing background noise; decrease if quiet sources are missed.
SILENCE_THRESHOLD=1000

# Minimum average RMS across the full buffer required before calling Shazam.
# Guards against transient noises (amp click, vinyl needle drop) that trigger
# buffering but don't sustain enough signal for identification.
IDENTIFY_THRESHOLD=1000

# Seconds of silence required to consider a track ended (continuous mode only)
SILENCE_DURATION=1

# Seconds to wait before retrying a failed identification (continuous mode only)
RETRY_INTERVAL=30

# ── Database ─────────────────────────────────────────────────────────
DB_PATH=/var/lib/song-tracker/songs.db

# ── Web server ───────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ── Logging ──────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
